# =============================================================================
# Magic City Plant-A-Palooza — environment variables
# =============================================================================
# 1. Copy this file:    cp .env.local.example .env.local
# 2. Fill in real values below (see README.md "Service Account Setup" for links).
# 3. NEVER commit .env.local — it's in .gitignore for a reason.
# -----------------------------------------------------------------------------

# --- Supabase (https://supabase.com/dashboard) -------------------------------
# Settings → API Keys:
#   • Project URL → NEXT_PUBLIC_SUPABASE_URL
#   • Legacy tab → "anon" public key (JWT starting with eyJ) → NEXT_PUBLIC_SUPABASE_ANON_KEY
#     Do NOT use sb_publishable_... here — this app uses the legacy anon JWT.
#   • Legacy tab → service_role key (JWT, secret) → SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...YOUR-LEGACY-ANON-PUBLIC-KEY

SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR-LEGACY-SERVICE-ROLE-KEY

# --- Mapbox (https://account.mapbox.com/access-tokens/) ----------------------
# Create a public token with styles:read, fonts:read, datasets:read scopes
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR-MAPBOX-PUBLIC-TOKEN

# --- Resend (https://resend.com/api-keys) ------------------------------------
RESEND_API_KEY=re_YOUR-RESEND-API-KEY

# Email address that receives new vendor application notifications
ORGANIZER_EMAIL=organizer@magiccityplantapalooza.com

# --- Curator.io (https://app.curator.io/) ------------------------------------
# Found in your feed embed code: data-feed-id="..."
NEXT_PUBLIC_CURATOR_FEED_ID=YOUR-CURATOR-FEED-ID

# --- Site ---------------------------------------------------------------------
# Used for email links, canonical URLs, etc. Set to your prod domain in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
